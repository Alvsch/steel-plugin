package host:plugin-sdk@0.3.0;

interface rpc {
    enum rpc-error {
        unknown-method,
        invalid-request,
        response-serialization-failed,
    }

    resource method {
        dispatch: func(data: list<u8>) -> result<option<list<u8>>, rpc-error>;
    }

    resolve-method: func(plugin-name: string, method-name: string) -> option<method>;
}
