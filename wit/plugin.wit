package host:plugin-sdk@0.2.0;

interface plugin-api {
    use event.{event};
    use rpc.{rpc-error};

    on-enable: func();
    on-disable: func();

    rpc: func(method-name: string, data: list<u8>) -> result<option<list<u8>>, rpc-error>;
    event-handler: func(handler-id: u32, event: event);
}

world plugin-world {
    import logging;
    import player;
    import rpc;
    import event;

    export plugin-api;
}